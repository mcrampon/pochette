<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The session can only be read with this phone's keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
